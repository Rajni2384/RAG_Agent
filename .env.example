# Copy this file to `.env` and fill in the values. Never commit `.env`.

# OpenAI-compatible API key (e.g. Groq free tier: https://console.groq.com/keys)
LLM_API_KEY=

# Any OpenAI-compatible model your provider serves (e.g. openai/gpt-oss-20b)
LLM_MODEL=

# Base URL for the provider. Leave empty for OpenAI's default.
# Groq example: https://api.groq.com/openai/v1
LLM_BASE_URL=